    },
    {
      "page": "/api/products",
      "regex": "^/api/products(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/products(?:/)?$"
    },
    {
      "page": "/api/settings",
      "regex": "^/api/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/settings(?:/)?$"
    },
    {
      "page": "/api/sync",
