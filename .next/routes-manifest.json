    },
    {
      "page": "/bakes-and-small-chops",
      "regex": "^/bakes\\-and\\-small\\-chops(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/bakes\\-and\\-small\\-chops(?:/)?$"
    },
    {
      "page": "/cakes",
      "regex": "^/cakes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/cakes(?:/)?$"
